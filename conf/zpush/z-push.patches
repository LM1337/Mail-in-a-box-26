            if (defined('LOGAUTHFAIL') && LOGAUTHFAIL != false && Request::HasAuthenticationInfo()) // MIAB-B126: only when a password was sent
                ZLog::Write(LOGLEVEL_WARN, sprintf("Failed to authenticate user '%2\$s' from IP %1\$s.",  Request::GetRemoteAddr(), Request::GetAuthUser()? Request::GetAuthUser(): Request::GetGETUser() ));
>>>

