            if (strpos(implode(' ', (array) imap_errors()), '[AUTHENTICATIONFAILED]') === false) throw new ServiceUnavailableException("BackendIMAP->Logon(): Dovecot did not check the password (a temporary failure, not a wrong password)"); // MIAB-B126
            return false;
>>>

