# B128: Z-Push's id of a card is its name on the server without ".vcf", and
# its CardDAV client asked only for id + ".vcf". A card whose name has no
# extension (Nextcloud's example contact "default", the cards of some other
# clients) was then missing from the answer, as Nextcloud leaves a name it
# does not know out of a multiget (no 404 for it), and GetMessage() failed
# with a fatal error that ended the whole Sync request with HTTP 500.

@@ include/z_carddav.php
<<<
    public function get_xml_vcard($vcard_id) {
//         ZLog::Write(LOGLEVEL_DEBUG, sprintf("BackendCardDAV->carddav_backend->get_xml_vcard"));
        $href = $this->url_parts['path'] . str_replace($this->url_vcard_extension, null, $vcard_id) . $this->url_vcard_extension;

        // If we don't ask for allprop, SOGo doesn't return the content_type
        $xml = <<<EOFXMLGETXMLVCARD
<?xml version="1.0" encoding="utf-8" ?>
<C:addressbook-multiget xmlns:D="DAV:" xmlns:C="urn:ietf:params:xml:ns:carddav">
    <D:prop>
        <D:getetag/>
        <D:getlastmodified/>
        <C:address-data>
            <C:allprop/>
        </C:address-data>
    </D:prop>
    <D:href>$href</D:href>
</C:addressbook-multiget>
EOFXMLGETXMLVCARD;

        return $this->do_query_report($xml);
    }
===
    public function get_xml_vcard($vcard_id) {
//         ZLog::Write(LOGLEVEL_DEBUG, sprintf("BackendCardDAV->carddav_backend->get_xml_vcard"));
        // MIAB-B128: the id is the card's name without the extension. Ask for
        // the name with the extension first, then for the name without it: a
        // server leaves a name it does not know out of the multiget answer.
        $name = str_replace($this->url_vcard_extension, '', $vcard_id);
        $names = array($name . $this->url_vcard_extension);
        if (strlen($this->url_vcard_extension) > 0) {
            $names[] = $name;
        }
        foreach ($names as $n) {
            $href = $this->url_parts['path'] . $n;

            // If we don't ask for allprop, SOGo doesn't return the content_type
            $xml = <<<EOFXMLGETXMLVCARD
<?xml version="1.0" encoding="utf-8" ?>
<C:addressbook-multiget xmlns:D="DAV:" xmlns:C="urn:ietf:params:xml:ns:carddav">
    <D:prop>
        <D:getetag/>
        <D:getlastmodified/>
        <C:address-data>
            <C:allprop/>
        </C:address-data>
    </D:prop>
    <D:href>$href</D:href>
</C:addressbook-multiget>
EOFXMLGETXMLVCARD;

            $result = $this->do_query_report($xml);
            $found = new SimpleXMLElement($result);
            if (isset($found->element[0])) {
                break;
            }
        }
        return $result;
    }

    /**
     * MIAB-B128: the name of an existing card on the server and its UID: the
     * id with the extension, or else the id without it (Nextcloud's example
     * contact "default"). For a card that is on the server under neither name,
     * the name with the extension and no UID.
     *
     * @param	string	$vcard_id	vCard id on the CardDAV server
     * @return	array				(name, UID or null)
     */
    private function existing_vcard($vcard_id) {
        $names = array($vcard_id . $this->url_vcard_extension);
        if (strlen($this->url_vcard_extension) > 0) {
            $names[] = $vcard_id;
        }
        foreach ($names as $name) {
            $result = $this->query($this->url . $name, 'GET');
            if ($result['http_code'] == 200) {
                $uid = null;
                $unfolded = preg_replace("/\r?\n[ \t]/", '', $result['response']);
                if (preg_match('/^UID:(.*?)\r?$/mi', $unfolded, $m) && trim($m[1]) !== '') {
                    $uid = trim($m[1]);
                }
                return array($name, $uid);
            }
        }
        return array($names[0], null);
    }
>>>

